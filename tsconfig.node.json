{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@server/*": ["server/*"],
      "@schemas/*": ["server/schemas/*"]
    }
  },
  // `vitest.reporter.ts` is Node code (fs, process, path) and, like `vitest.setup.ts` in
  // the app project, it must belong to *some* project or ESLint's type-aware rules cannot
  // parse it.
  "include": [
    "server",
    "vite.config.ts",
    "vitest.reporter.ts",
    "vitest.reporter.test.ts",
    "styles.invariants.test.ts"
  ]
}
