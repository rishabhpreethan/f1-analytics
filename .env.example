# Copy to .env only if you need to override a default. Neither variable is required,
# and there are no secrets in this application — it reads one local SQLite file and
# makes no third-party network call.

# Port the API server listens on.
PORT=8787

# Absolute or relative path to the database file. Defaults to ./data/f1.db.
# This is operator configuration and can never originate in an HTTP request.
F1_DB_PATH=data/f1.db
